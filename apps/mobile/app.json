{
  "expo": {
    "name": "ZADPAY",
    "slug": "zadpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "zadpay",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4B1F8A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zadpay.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ZADPAY needs your camera to scan your ID and verify your identity.",
        "NSFaceIDUsageDescription": "ZADPAY uses Face ID to keep your account secure."
      }
    },
    "android": {
      "package": "com.zadpay.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "packagingOptions": {
        "pickFirst": [
          "lib/x86/librnworklets.so",
          "lib/x86_64/librnworklets.so",
          "lib/armeabi-v7a/librnworklets.so",
          "lib/arm64-v8a/librnworklets.so"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter_400Regular.ttf",
            "./assets/fonts/Inter_500Medium.ttf",
            "./assets/fonts/Inter_600SemiBold.ttf",
            "./assets/fonts/Inter_700Bold.ttf",
            "./assets/fonts/Sora_700Bold.ttf",
            "./assets/fonts/ionicons.ttf",
            "./assets/fonts/material-community.ttf",
            "./assets/fonts/FontAwesome5Free-Regular.ttf",
            "./assets/fonts/FontAwesome5Free-Solid.ttf",
            "./assets/fonts/FontAwesome5Free-Brand.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ZADPAY to access your camera to verify your identity."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ZADPAY to use Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4B1F8A",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3a43ceff-2f2d-41fb-9688-bbdc7a9a29b1"
      },
      "apiBaseUrl": "http://ec2-13-63-246-134.eu-north-1.compute.amazonaws.com",
      "appEnv": "development"
    },
    "owner": "mohammadalaydi"
  }
}
