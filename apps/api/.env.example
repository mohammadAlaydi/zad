NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database — must include schemas in the public search_path so Prisma can
# resolve the multi-schema setup. The schemas themselves (identity/kyc/
# wallet/shared) are created by `prisma migrate dev`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zadpay?schema=public

REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

# Comma-separated origins allowed by CORS. Empty = no origins.
# Expo dev server runs on 8081 (web) / 19000 (legacy) / 19006 (dev tools).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma-separated IPs allowed to scrape /metrics. Default = loopback only.
# In prod, set to your Prometheus scraper's source IPs.
METRICS_ALLOWLIST=127.0.0.1,::1

# Optional in dev, REQUIRED in production (env validation will refuse to boot).
# SENTRY_DSN=https://example@sentry.io/1234567
# OTLP_ENDPOINT=http://localhost:4318
