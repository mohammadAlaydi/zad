NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database — must include schemas in the public search_path so Prisma can
# resolve the multi-schema setup. The schemas themselves (identity/kyc/
# wallet/shared) are created by `prisma migrate dev`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zadpay?schema=public

REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

# Comma-separated origins allowed by CORS. Empty = no origins.
# Expo dev server runs on 8081 (web) / 19000 (legacy) / 19006 (dev tools).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma-separated IPs allowed to scrape /metrics. Default = loopback only.
METRICS_ALLOWLIST=127.0.0.1,::1

# ── Identity / auth (ADR-0006) ────────────────────────────────────────
# Generate dev keys once and append to .env:
#   pnpm --filter @zadpay/api run keygen >> .env
# In production these come from the cloud secret manager — never baked in.
# Multi-line values are supported by Node's --env-file when quoted.
JWT_SIGNING_KEY=
JWT_VERIFY_KEY=
REFRESH_TOKEN_PEPPER=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Optional in dev, REQUIRED in production (env validation refuses to boot).
# SENTRY_DSN=https://example@sentry.io/1234567
# OTLP_ENDPOINT=http://localhost:4318

# ── Push notifications (Firebase Cloud Messaging) ─────────────────────
# Provide ONE of FIREBASE_CREDENTIALS_JSON (inline JSON, useful for
# CI/secrets managers) or FIREBASE_CREDENTIALS_PATH (path to the
# service-account JSON on disk). If both are unset, push delivery
# silently no-ops via NoopNotificationSender — the rest of the app keeps
# working (DB rows for /v1/notifications inbox are still created).
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS_PATH=/home/ubuntu/zadpay/apps/api/firebase-service-account.json
