// Prisma schema — multi-schema for module isolation per ADR-0005.
// Cross-namespace foreign keys are forbidden; modules reference by ID only.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["identity", "kyc", "wallet", "shared", "userdata"]
  extensions = [citext]
}

// ──────────────────────────────────────────────────────────────────────
// shared.* — cross-cutting platform tables. Per ADR-0005 these are the
// only tables touched by infrastructure, not by any module's domain.
// ──────────────────────────────────────────────────────────────────────

/// Transactional outbox. Writers append rows in the same DB tx as the state
/// change; a background dispatcher reads unpublished rows and forwards them
/// to the EventBus. Drop-in replacement for Kafka/RabbitMQ producer.
model EventOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateId String    @map("aggregate_id") @db.Uuid
  eventName   String    @map("event_name") @db.VarChar(120)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt])
  @@index([eventName])
  @@map("event_outbox")
  @@schema("shared")
}

/// Append-only audit log. Postgres-level grants on this table are
/// INSERT-only for the app user — see ADR-0006.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  ts        DateTime @default(now())
  actorId   String?  @map("actor_id") @db.Uuid
  actorRole String?  @map("actor_role") @db.VarChar(60)
  action    String   @db.VarChar(120)
  targetId  String?  @map("target_id") @db.Uuid
  ip        String?  @db.Inet
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id") @db.Uuid
  metadata  Json?

  @@index([ts])
  @@index([actorId, ts])
  @@index([action, ts])
  @@map("audit_log")
  @@schema("shared")
}

/// Idempotency keys — Redis is the fast path, this is the source of truth.
/// Per ADR-0007 the wallet ledger has its own unique constraint on
/// idempotency_key; this table covers all other endpoints uniformly.
model IdempotencyKey {
  key        String   @id @db.Uuid
  hash       String   @db.VarChar(64) // sha256 hex of method + path + body
  status     String   @db.VarChar(20) // 'in_progress' | 'done' | 'failed'
  statusCode Int?     @map("status_code")
  response   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("shared")
}

// ──────────────────────────────────────────────────────────────────────
// identity.* — auth, user accounts, refresh tokens. See ADR-0006.
// No cross-schema FKs — other modules reference users by id only.
// ──────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  kycStatus    String   @default("not_started") @map("kyc_status") @db.VarChar(20)
  roles        String[] @default(["customer"])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
  @@schema("identity")
}

/// Refresh tokens are one-time-use with rotation. Reuse of a revoked token
/// from the same `family` triggers full-family revocation (ADR-0006).
/// `tokenHash` is the argon2id-hashed token; the plaintext is shown to the
/// client exactly once at issue time.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  family    String    @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  // null until rotated; set to the new token's id so we can detect replay.
  rotatedTo String?   @map("rotated_to") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("identity")
}

// ──────────────────────────────────────────────────────────────────────
// kyc.* — KYC applications and documents (ADR-0008). No SQL FK to
// identity.users — `userId` is a soft reference; user existence is
// enforced by the auth layer, not the schema.
// ──────────────────────────────────────────────────────────────────────

model KycApplication {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  provider        String    @db.VarChar(40) // 'inmem' | 'sumsub' | 'onfido' | ...
  providerRef     String?   @map("provider_ref") @db.VarChar(255)
  status          String    @db.VarChar(20) // pending | submitted | review | approved | rejected
  submittedAt     DateTime? @map("submitted_at")
  decidedAt       DateTime? @map("decided_at")
  rejectionReason String?   @map("rejection_reason")
  // Append-only transition log: [{ from, to, at, by, reason? }, ...]
  history         Json      @default("[]")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  documents KycDocument[]

  @@map("applications")
  @@schema("kyc")
}

model KycDocument {
  id            String    @id @default(uuid()) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  type          String    @db.VarChar(40) // passport | national_id | driving_licence | selfie | proof_of_address
  s3Key         String    @map("s3_key") @db.VarChar(512)
  mimeType      String    @map("mime_type") @db.VarChar(120)
  sizeBytes     Int?      @map("size_bytes")
  uploadedAt    DateTime? @map("uploaded_at")
  providerRef   String?   @map("provider_ref") @db.VarChar(255)
  status        String    @db.VarChar(20) // pending | uploaded | submitted | accepted | rejected
  createdAt     DateTime  @default(now()) @map("created_at")

  application KycApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("documents")
  @@schema("kyc")
}

// ──────────────────────────────────────────────────────────────────────
// wallet.* — double-entry ledger per ADR-0007. Balances are derived from
// SUM(ledger_entries); the account_balances projection is updated in the
// same DB transaction that posts entries (so it can never drift). No SQL
// FK to identity — userId is a soft reference.
// ──────────────────────────────────────────────────────────────────────

model WalletAccount {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  currency  String   @db.VarChar(3)
  type      String   @db.VarChar(30) // 'wallet' | 'reserve' | 'fee' | 'external_clearing'
  status    String   @default("active") @db.VarChar(20) // 'active' | 'frozen' | 'closed'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ledgerEntries WalletLedgerEntry[]
  balance       WalletAccountBalance?

  @@unique([ownerId, currency, type])
  @@index([ownerId])
  @@map("accounts")
  @@schema("wallet")
}

model WalletTransaction {
  id             String    @id @default(uuid()) @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  type           String    @db.VarChar(40) // 'transfer' | 'topup' | 'withdrawal' | 'fee' | 'reversal' | 'adjustment'
  status         String    @db.VarChar(20) // 'pending' | 'posted' | 'reversed'
  createdAt      DateTime  @default(now()) @map("created_at")
  postedAt       DateTime? @map("posted_at")
  metadata       Json      @default("{}")

  ledgerEntries WalletLedgerEntry[]

  @@index([createdAt])
  @@map("transactions")
  @@schema("wallet")
}

/// Postgres trigger (`enforce_ledger_balance` in the initial migration)
/// ensures every transaction's debits + credits sum to zero — no
/// half-posted transactions.
model WalletLedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  direction     String   @db.VarChar(6) // 'debit' | 'credit'
  /// Always positive minor units; direction carries the sign.
  amount        Decimal  @db.Decimal(38, 0)
  currency      String   @db.VarChar(3)
  createdAt     DateTime @default(now()) @map("created_at")

  transaction WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
  @@schema("wallet")
}

/// Materialized projection of SUM(ledger_entries). Updated by the same
/// transaction that posts entries — reads are O(1) instead of O(N). The
/// nightly reconciliation job recomputes from ledger_entries and pages
/// on-call if there's any drift.
model WalletAccountBalance {
  accountId String   @id @map("account_id") @db.Uuid
  amount    Decimal  @db.Decimal(38, 0)
  currency  String   @db.VarChar(3)
  updatedAt DateTime @updatedAt @map("updated_at")

  account WalletAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_balances")
  @@schema("wallet")
}

// ──────────────────────────────────────────────────────────────────────
// userdata.* — generic per-user JSON store. Used by the mobile features
// that don't have their own domain module yet (cards, goals, savings,
// bnpl, vouchers, loyalty, scheduled, holdings, etc.). Each row carries
// a `feature` tag and an opaque JSON payload — the mobile owns the
// payload shape per feature.
//
// Soft userId reference (no FK) per ADR-0005's no-cross-schema-FK rule.
// ──────────────────────────────────────────────────────────────────────

model UserItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  feature   String   @db.VarChar(40)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, feature])
  @@index([userId, feature, createdAt])
  @@map("items")
  @@schema("userdata")
}
