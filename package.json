{
  "name": "zadpay-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "pnpm --filter @zadpay/mobile",
    "api": "pnpm --filter @zadpay/api",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.27.0"
    }
  }
}
